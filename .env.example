# Copy this file to .env and fill in your values.
# The application loads it with python-dotenv.

GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=f1_raw
BQ_LOCATION=US
GCS_BUCKET=your-raw-data-bucket
PUBSUB_TOPIC=f1-live-events
DASHBOARD_MODE=warehouse

# Optional dashboard/model artifact override.
MODEL_METRICS_PATH=models/finishing_position_metrics.json

# Optional. Required only for authenticated OpenF1 live-session access.
OPENF1_ACCESS_TOKEN=

# Prefer `gcloud auth application-default login` for local development.
# In Cloud Run, attach a least-privilege service account instead of a key file.
