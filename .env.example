# Copy this file to .env and fill in your values.
# Load with `python-dotenv` or `export $(cat .env | xargs)` before running scripts.

GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=f1_raw

# Path to a service account JSON key with BigQuery Data Editor + Job User roles.
# Not needed if using `gcloud auth application-default login` locally.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
